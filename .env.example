# Copy with scripts/init-env.ps1 to generate unique values. Do not commit .env.
ZERO_PAID_MODE=true
GROK_ENABLED=false
RETRIEVAL_BACKEND=lexical
INSTALL_SEMANTIC=false
# Optional local llama.cpp inference. The default Compose file stays in demo mode.
# compose.slm.yaml enables it on the private network after model preparation.
SLM_ENABLED=false
LOCAL_SLM_URL=http://127.0.0.1:8012/v1
SLM_MODEL_ID=Llama-3.2-3B-Instruct
LOCAL_SLM_FOLLOWUPS=false
# Leave blank to reuse INTERNAL_SERVICE_TOKEN for the private Compose model API.
SLM_API_KEY=
INTERNAL_SERVICE_TOKEN=
JWT_SECRET=
POSTGRES_USER=placement
POSTGRES_PASSWORD=
POSTGRES_DB=placement
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_ENABLED=true
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173,http://127.0.0.1:5173
